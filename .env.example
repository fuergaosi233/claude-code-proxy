# Required: Your OpenAI API key
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Optional: Expected Anthropic API key for client validation
# If set, clients must provide this exact API key to access the proxy
ANTHROPIC_API_KEY="your-expected-anthropic-api-key"

# Optional: Fake organization id returned by the desktop-compat endpoints
# (GET /api/organizations, /v1/me, connector/plugin listings). Claude Code
# Desktop probes these when opening the connectors/plugins browse UI.
# PROXY_ORG_ID="claude-code-proxy-org"

# Optional: OpenAI API base URL (default: https://api.openai.com/v1)
# You can change this to use other providers like Azure OpenAI, local models, etc.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional: Model mappings (BIG, MIDDLE, and SMALL models)
# Each tier can have a comma-separated list of models for automatic fallback.
# The first model is the primary; subsequent models are fallbacks in case of errors.
# When a model fails (429 rate limit, 503 errors, "model not found", etc.),
# the proxy automatically switches to the next fallback.
# The background health checker periodically probes primary models and restores them
# when they heal. Example: BIG_MODEL="gpt-4o,gpt-4o-mini,llama3.1:70b"
BIG_MODEL="gpt-4o"
# Used for Claude opus requests
MIDDLE_MODEL="gpt-4o"
# Used for Claude sonnet requests
SMALL_MODEL="gpt-4o-mini"
# Used for Claude haiku requests

# Optional: Reasoning effort defaults (used only when Claude Code sends no
# /effort level; an in-session /effort always overrides these).
# Accepted values: low | medium | high | max | xhigh   (xhigh == max)
# These route to each model's native envelope — e.g. GLM-5.x get low/high/max,
# gpt-oss gets low/medium/high, deepseek-v4.x gets low/high (medium nudged up),
# and Nemotron gets chat_template_kwargs thinking switches.
# REASONING_EFFORT="high"   # global default (built-in fallback: high)
# Per-tier overrides of the global default (each independent):
# BIG_MODEL_EFFORT="high"
# MIDDLE_MODEL_EFFORT="medium"
# SMALL_MODEL_EFFORT="low"

# Optional: Server settings
HOST="0.0.0.0"
PORT="8082"
LOG_LEVEL="INFO"  
# DEBUG, INFO, WARNING, ERROR, CRITICAL

# Optional: Performance settings 
MAX_TOKENS_LIMIT="4096"
# Minimum tokens limit for requests (to avoid errors with thinking model)
MIN_TOKENS_LIMIT="4096"

# Optional: Model failure and health check settings
# Controls automatic model fallback behavior and restore polling.
MODEL_FAILURE_THRESHOLD="3" # Number of consecutive failures before switching to next model
MODEL_HEALTH_CHECK_INTERVAL="60" # Seconds between checking if primary models can be restored
MODEL_PROBE_TIMEOUT="10" # Timeout in seconds for health check probe requests
MODEL_PROBE_MAX_TOKENS="1" # Keep probe requests tiny to avoid unnecessary costs
MODEL_RESTORE_BACKOFF_MAX="8" # Cap exponential backoff at this many intervals (default: 8)

REQUEST_TIMEOUT="90"
MAX_RETRIES="2"

# Optional: Context window management
# The proxy automatically trims old conversation turns when the message history
# approaches the model's context limit. This prevents 400 "context_length_exceeded"
# errors that would otherwise halt Claude Code mid-session.
#
# CONTEXT_TRIM_RATIO: fraction of the context window reserved for input (default: 0.85).
#   Lower values leave more headroom for output. Raise to 0.9+ for very long outputs.
CONTEXT_TRIM_RATIO="0.85"
#
# MODEL_CONTEXT_LIMITS: comma-separated overrides for context and output limits.
#   Format: model_name_substring:context_tokens:max_output_tokens
#   Example to override gpt-4o limits and add a custom model:
# MODEL_CONTEXT_LIMITS="gpt-4o:128000:16384,my-custom-model:32000:4096"


# Examples for other providers:

# For Azure OpenAI (recommended if OpenAI is not available in your region):
# OPENAI_API_KEY="your-azure-api-key"
# OPENAI_BASE_URL="https://your-resource-name.openai.azure.com/openai/deployments/your-deployment-name"
# AZURE_API_VERSION="2024-03-01-preview"
# BIG_MODEL="gpt-4"
# MIDDLE_MODEL="gpt-4"
# SMALL_MODEL="gpt-35-turbo"

# For local models (like Ollama):
# OPENAI_API_KEY="dummy-key"  # Required but can be any value for local models
# OPENAI_BASE_URL="http://localhost:11434/v1"
# BIG_MODEL="llama3.1:70b"
# MIDDLE_MODEL="llama3.1:70b"
# SMALL_MODEL="llama3.1:8b"

# Note: If you get "unsupported_country_region_territory" errors,
# consider using Azure OpenAI or a local model setup instead.


# Custom Headers Configuration
# Format: HEADER_KEY=header_value
# These headers will be automatically included in API requests
# Uncomment the lines below to use custom headers:
# CUSTOM_HEADER_ACCEPT="application/jsonstream"
# CUSTOM_HEADER_CONTENT_TYPE="application/json"
# CUSTOM_HEADER_USER_AGENT="node-fetch"
# CUSTOM_HEADER_HOST="example.com"
# CUSTOM_HEADER_AUTHORIZATION="Bearer your-token"
# CUSTOM_HEADER_X_API_KEY="your-api-key"
# CUSTOM_HEADER_X_CLIENT_ID="your-client-id"
